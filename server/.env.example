# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ironpulse
PORT=3000
# Make one with: node -p "crypto.randomBytes(32).toString('hex')"
JWT_SECRET=replace-with-a-long-random-string
# The address of the React app (used for CORS, no trailing /)
CLIENT_ORIGIN=http://localhost:5173
# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@ironpulse.test
ADMIN_PASSWORD=change-me-please
