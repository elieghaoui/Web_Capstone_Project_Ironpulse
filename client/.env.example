# Copy this file to .env.development (for npm run dev) and fill in the API address:
#   on your laptop: the address of your local API (the port in server/.env, 3000 by default)
#   live: don't use a file, set VITE_API_URL in Vercel's settings to the Render address
# Every VITE_ value ships to the browser: never put secrets here. No trailing /.
VITE_API_URL=<your-api-address>
